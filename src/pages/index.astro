---
// 04/08/2026: por decisão da Toré, o EDTMusic deixou de ter site próprio.
// O conteúdo de serviço (distribuição: envie a música, aprovação com o Eder,
// música no ar) foi levado para emmusicproducoes.com.br, seção "Distribuição".
// A vitrine de artista continua em eder.edtmusic.com.br.
// Este domínio fica reservado, no mesmo padrão da loopsbrasil.com.br.
// O site antigo continua no histórico do Git, é só voltar o commit anterior.
const DESTINO = 'https://emmusicproducoes.com.br/#distribuicao';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>edtmusic.com.br | Domínio reservado pela Rede Loops Brasil</title>
    <meta name="robots" content="noindex" />
    <meta
      name="description"
      content="O EDTMusic agora atende pela EM Music Produções. Gravação, mixagem, masterização e distribuição num lugar só."
    />
    <link rel="icon" href="/favicon.png" />
    <style>
      html, body {
        margin: 0;
        padding: 0;
        background: #0B0B0C;
        color: #F7F4EE;
        font-family: -apple-system, "Segoe UI", Roboto, sans-serif;
      }
      main {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 2rem 1.5rem;
      }
      img {
        height: 64px;
        width: auto;
        margin-bottom: 1.5rem;
      }
      p.tag {
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        color: #D33D3F;
        margin: 0 0 1rem;
      }
      h1 {
        font-size: 1.75rem;
        line-height: 1.4;
        margin: 0 0 1rem;
        max-width: 32rem;
      }
      p.desc {
        font-size: 1rem;
        color: rgba(247, 244, 238, 0.7);
        max-width: 28rem;
        margin: 0 0 2rem;
      }
      a.cta {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: linear-gradient(to right, #4A39A2, #D33D3F);
        color: #F7F4EE;
        padding: 0.9rem 2rem;
        border-radius: 999px;
        text-decoration: none;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-size: 0.95rem;
      }
      a.secundario {
        display: inline-block;
        margin-top: 1.25rem;
        font-size: 0.85rem;
        color: rgba(247, 244, 238, 0.55);
        text-decoration: none;
        border-bottom: 1px solid rgba(247, 244, 238, 0.25);
        padding-bottom: 2px;
      }
    </style>
  </head>
  <body>
    <main>
      <img src="/images/edtmusic-logo.png" alt="EDTMusic" />
      <p class="tag">Rede Loops Brasil</p>
      <h1>O EDTMusic agora atende pela EM Music Produções</h1>
      <p class="desc">
        Gravação, mixagem, masterização e o lançamento da sua música no Spotify,
        Deezer, Apple Music e YouTube ficaram num lugar só, em
        emmusicproducoes.com.br.
      </p>
      <a class="cta" href={DESTINO}>Lançar minha música</a>
      <a class="secundario" href="https://eder.edtmusic.com.br"
        >Ouvir as músicas do Eder Machado</a
      >
    </main>
  </body>
</html>
