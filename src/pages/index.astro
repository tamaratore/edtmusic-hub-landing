---
import Base from '../layouts/Base.astro';
import RedeFooter from '../components/RedeFooter.astro';

const artistas = [
  {
    nome: 'Eder Machado',
    desc: 'Música e clipes autorais',
    avatar: '/images/eder-avatar.png',
    href: 'https://eder.edtmusic.com.br',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'MusicGroup',
  name: 'EDTMusic',
  url: 'https://edtmusic.com.br',
};
---
<Base
  title="EDTMusic | Selo de artistas"
  description="EDTMusic é o selo que reúne os artistas da Rede Loops Brasil. Conheça as músicas e os clipes de cada um."
  redeAtual="EDTMusic"
  structuredData={structuredData}
>
  <main class="flex min-h-[calc(100vh-49px)] flex-col items-center justify-center px-4 py-16 sm:px-6">
    <div class="mx-auto flex w-full max-w-2xl flex-col items-center text-center">
      <img
        src="/images/edtmusic-logo.png"
        alt="EDTMusic"
        class="h-16 w-auto sm:h-20"
        width="200"
        height="80"
      />

      <h1 class="mt-8 font-display text-3xl uppercase leading-tight text-paper sm:text-4xl">
        O selo dos artistas da rede
      </h1>
      <p class="balance mt-4 max-w-md text-sm text-paper/60 sm:text-base">
        Aqui você encontra os artistas que gravam, lançam e distribuem música
        pela EDTMusic. Escolha um artista pra conhecer as músicas e os clipes.
      </p>

      <div class="mt-12 grid w-full gap-4 sm:grid-cols-2">
        {artistas.map((artista) => (
          <a
            href={artista.href}
            class="glow-card flex items-center gap-4 rounded-2xl border border-ink-line bg-ink-raised p-4 text-left transition hover:border-brand-orange/40"
          >
            <img
              src={artista.avatar}
              alt={artista.nome}
              class="h-16 w-16 shrink-0 rounded-full object-cover"
              width="64"
              height="64"
            />
            <div>
              <p class="font-semibold text-paper">{artista.nome}</p>
              <p class="mt-0.5 text-xs text-paper/50">{artista.desc}</p>
            </div>
          </a>
        ))}
      </div>
    </div>

    <div class="mx-auto mt-20 w-full max-w-5xl">
      <RedeFooter atual="EDTMusic" />
    </div>
  </main>
</Base>
