---
import Base from '../layouts/Base.astro';
import RedeFooter from '../components/RedeFooter.astro';

const WHATSAPP_URL = 'https://wa.me/5521959267432?text=' + encodeURIComponent('Vim pelo site da EDTMusic! Quero saber mais sobre o selo.');

// logos oficiais de cada plataforma, mesma fonte (Ditto Music/ffm.to) já usada em
// emmusicproducoes.com.br e eder.edtmusic.com.br
const PLATFORM_LOGOS = {
  spotify: 'https://cloudinary-cdn.ffm.to/s--DnYCoqSX--/w_64,h_64,c_limit/f_webp/https%3A%2F%2Fassets.ffm.to%2Fimages%2Flogo%2Fmusic-service_spotify_without_text.png',
  apple: 'https://cloudinary-cdn.ffm.to/s--tXfmuRiI--/w_64,h_64,c_limit/f_webp/https%3A%2F%2Fassets.ffm.to%2Fimages%2Flogo%2Fmusic-service_applemusic_without_text.png',
  deezer: 'https://cloudinary-cdn.ffm.to/s--8rjR1rrJ--/w_64,h_64,c_limit/f_webp/https%3A%2F%2Fassets.ffm.to%2Fimages%2Flogo%2Fmusic-service_deezer_without_text_new.png',
  youtube: 'https://cloudinary-cdn.ffm.to/s--3lH9NQ9o--/w_64,h_64,c_limit/f_webp/https%3A%2F%2Fassets.ffm.to%2Fimages%2Flogo%2Fmusic-service_youtube_without_text.png',
};

const etapas = [
  {
    n: '1',
    titulo: 'Envie sua música pronta',
    desc: 'Áudio masterizado, capa e créditos certos. Nossa equipe orienta você em cada etapa.',
  },
  {
    n: '2',
    titulo: 'Aprovação com o Produtor Eder Machado',
    desc: 'Ele avalia e aprova o lançamento antes de ir pro ar, prazo combinado direto com você.',
  },
  {
    n: '3',
    titulo: 'Distribuição oficial nas plataformas',
    desc: 'Spotify, Apple Music, Deezer, YouTube e mais, com direitos autorais e arrecadação em dia.',
  },
];

// roster com 1 artista só fica esquisito exposto - escondido até ter mais gente
// (Toré, 21/07). Mantido aqui pronto pra reativar o grid quando crescer.
const artistas = [
  {
    nome: 'Eder Machado',
    desc: 'Música e clipes autorais',
    avatar: '/images/eder-avatar.png',
    href: 'https://eder.edtmusic.com.br',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'MusicGroup',
  name: 'EDTMusic',
  url: 'https://edtmusic.com.br',
};
---
<Base
  title="EDTMusic | Selo de artistas"
  description="EDTMusic é o selo que reúne os artistas da Rede Loops Brasil. Conheça as músicas e os clipes de cada um."
  redeAtual="EDTMusic"
  structuredData={structuredData}
>
  <main class="flex min-h-[calc(100vh-49px)] flex-col items-center justify-center px-4 py-16 sm:px-6">
    <div class="mx-auto flex w-full max-w-2xl flex-col items-center text-center">
      <img
        src="/images/edtmusic-logo.png"
        alt="EDTMusic"
        class="h-16 w-auto sm:h-20"
        width="200"
        height="80"
      />

      <div class="mx-auto mt-6 flex h-10 items-end justify-center gap-1" aria-hidden="true">
        <span class="eq-bar w-1.5 rounded-full bg-brand-orange"></span>
        <span class="eq-bar w-1.5 rounded-full bg-brand-orange"></span>
        <span class="eq-bar w-1.5 rounded-full bg-brand-orange"></span>
        <span class="eq-bar w-1.5 rounded-full bg-brand-orange"></span>
        <span class="eq-bar w-1.5 rounded-full bg-brand-orange"></span>
        <span class="eq-bar w-1.5 rounded-full bg-brand-orange"></span>
        <span class="eq-bar w-1.5 rounded-full bg-brand-orange"></span>
      </div>

      <h1 class="balance mt-6 font-display text-3xl uppercase leading-tight text-paper sm:text-4xl">
        Bora lançar suas músicas nas plataformas
      </h1>
      <p class="balance mt-4 max-w-md text-sm text-paper/60 sm:text-base">
        O selo que grava, lança e distribui sua música oficialmente nas
        plataformas digitais: direitos autorais, contratos e arrecadação, tudo
        certo.
      </p>

      <a
        href={WHATSAPP_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-7 inline-flex items-center gap-2.5 rounded-full bg-brand-orange px-8 py-4 font-display text-lg uppercase tracking-wide text-ink"
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5 fill-ink"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5.1-1.3A10 10 0 1 0 12 2Zm0 18.2a8.1 8.1 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.4-.7-1.7-.8s-.4-.1-.6.1-.7.8-.9 1-.3.2-.6 0a6.7 6.7 0 0 1-2-1.2 7.4 7.4 0 0 1-1.4-1.7c-.1-.2 0-.4.1-.5s.2-.3.4-.4a1.6 1.6 0 0 0 .2-.4.5.5 0 0 0 0-.4c0-.1-.6-1.5-.8-2s-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 2.9 2.9 0 0 0-.9 2.2 5.1 5.1 0 0 0 1.1 2.7 11.6 11.6 0 0 0 4.4 3.9c.6.3 1.1.4 1.5.5a3.6 3.6 0 0 0 1.6.1 2.7 2.7 0 0 0 1.8-1.2 2.1 2.1 0 0 0 .1-1.2c-.1-.1-.2-.2-.5-.3Z"/></svg>
        Falar com a EDTMusic
      </a>
    </div>

    <div class="mx-auto mt-20 w-full max-w-3xl px-4 sm:px-0">
      <h2 class="text-center font-display text-2xl text-paper sm:text-3xl">Como funciona o lançamento</h2>
      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        {etapas.map((e) => (
          <div class="glow-card rounded-2xl border border-ink-line bg-ink-raised p-5">
            <span class="font-display text-2xl text-brand-orange">{e.n}</span>
            <p class="mt-2 font-semibold text-paper">{e.titulo}</p>
            <p class="mt-1.5 text-sm text-paper/60">{e.desc}</p>
          </div>
        ))}
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-6 opacity-70">
        <img src={PLATFORM_LOGOS.spotify} alt="Spotify" class="h-6 w-6" loading="lazy" />
        <img src={PLATFORM_LOGOS.apple} alt="Apple Music" class="h-6 w-6" loading="lazy" />
        <img src={PLATFORM_LOGOS.deezer} alt="Deezer" class="h-6 w-6" loading="lazy" />
        <img src={PLATFORM_LOGOS.youtube} alt="YouTube" class="h-6 w-6" loading="lazy" />
      </div>

      <a
        href="https://emmusicproducoes.com.br"
        class="glow-card mt-10 flex flex-col items-center gap-3 rounded-2xl border border-ink-line bg-ink-raised p-6 text-center transition sm:flex-row sm:text-left"
      >
        <img
          src="/images/em-music-logo.png"
          alt="EM Music Produções"
          class="h-10 w-auto shrink-0"
          width="578"
          height="240"
        />
        <div>
          <p class="font-semibold text-paper">Ainda não gravou sua música?</p>
          <p class="mt-1 text-sm text-paper/60">
            A EM Music Produções grava, mixa e masteriza com o Eder Machado - deixa sua
            música pronta pra lançar pela EDTMusic.
          </p>
        </div>
      </a>
    </div>

    <div class="mx-auto mt-20 w-full max-w-5xl">
      <RedeFooter atual="EDTMusic" />
    </div>
  </main>
</Base>
