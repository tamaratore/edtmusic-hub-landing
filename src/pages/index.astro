---
import Base from '../layouts/Base.astro';
import RedeFooter from '../components/RedeFooter.astro';

const WHATSAPP_URL = 'https://wa.me/5521959267432?text=' + encodeURIComponent('Vim pelo site da EDTMusic! Quero saber mais sobre o selo.');

// logos oficiais de cada plataforma, mesma fonte (Ditto Music/ffm.to) já usada em
// emmusicproducoes.com.br e eder.edtmusic.com.br
const PLATFORM_LOGOS = {
  spotify: 'https://cloudinary-cdn.ffm.to/s--DnYCoqSX--/w_64,h_64,c_limit/f_webp/https%3A%2F%2Fassets.ffm.to%2Fimages%2Flogo%2Fmusic-service_spotify_without_text.png',
  apple: 'https://cloudinary-cdn.ffm.to/s--tXfmuRiI--/w_64,h_64,c_limit/f_webp/https%3A%2F%2Fassets.ffm.to%2Fimages%2Flogo%2Fmusic-service_applemusic_without_text.png',
  deezer: 'https://cloudinary-cdn.ffm.to/s--8rjR1rrJ--/w_64,h_64,c_limit/f_webp/https%3A%2F%2Fassets.ffm.to%2Fimages%2Flogo%2Fmusic-service_deezer_without_text_new.png',
  youtube: 'https://cloudinary-cdn.ffm.to/s--3lH9NQ9o--/w_64,h_64,c_limit/f_webp/https%3A%2F%2Fassets.ffm.to%2Fimages%2Flogo%2Fmusic-service_youtube_without_text.png',
};

// lançamentos reais distribuídos via Ditto Music (mesmos dados confirmados e
// usados em emmusicproducoes.com.br - EDTMusic e o selo por tras deles)
const releases = [
  {
    title: 'Não Estamos Sós',
    artist: 'Eder Machado',
    cover: 'https://imagestore.ffm.to/link/69f888bb2c00003300296abe/6a1ee4582c00000e00ac4635_1a50e44a432d66a4987cc5a967da99e0.jpeg',
    spotify: 'https://open.spotify.com/track/5WHnAnfjYAzth66TlOcQgl',
    apple: 'https://geo.music.apple.com/au/album/n%C3%A3o-estamos-s%C3%B3s/6775147902?i=6775147906',
    deezer: 'https://www.deezer.com/track/4055581231',
    youtube: 'https://www.youtube.com/watch?v=awWYAmkYsmE',
  },
  {
    title: 'Do Vale ao Monte',
    artist: 'Eder Machado',
    cover: 'https://imagestore.ffm.to/link/69f888bb2c00003300296abe/6a083afc3100003600eb82ea_14fe9b56d4a52b11f34ef030cd186e75.jpeg',
    spotify: 'https://open.spotify.com/track/5AtObetp8x0ojlEYdOHwpA',
    apple: 'https://geo.music.apple.com/au/album/do-vale-ao-monte/6769353647?i=6769353654',
    deezer: 'https://www.deezer.com/track/4027679111',
    youtube: 'https://www.youtube.com/watch?v=1T2blGbIRjA',
  },
  {
    title: 'Eu Escolho Lutar',
    artist: 'Eder Machado',
    cover: 'https://imagestore.ffm.to/link/69f888bb2c00003300296abe/6a02c73f2d00003300c94297_6d3fd31dfa5463a5b8eb8c78d47863fd.jpeg',
    spotify: 'https://open.spotify.com/track/2q29YnjNtaBSXxTgQa6Jwt',
    apple: 'https://geo.music.apple.com/au/album/eu-escolho-lutar/6767918975?i=6767918976',
    deezer: 'https://www.deezer.com/track/4011663231',
    youtube: 'https://www.youtube.com/watch?v=mkqrOhX8e3U',
  },
  {
    title: 'Fechado com Cristo',
    artist: 'Eder Machado & Steyce',
    cover: 'https://imagestore.ffm.to/link/69f888bb2c00003300296abe/6a083afd3100003600eb82eb_b775905b329cbb51d8dcfdcc6a1231b8.jpeg',
    spotify: 'https://open.spotify.com/track/56DURo3iGO9Eq1akpDDzR7',
    apple: 'https://geo.music.apple.com/au/album/fechado-com-cristo/6770305446?i=6770305447',
    deezer: 'https://www.deezer.com/track/4027047751',
    youtube: 'https://www.youtube.com/watch?v=Zmv0Mja3uDw',
  },
];

const etapas = [
  {
    n: '1',
    titulo: 'Envie sua música pronta',
    desc: 'Áudio masterizado, capa e créditos certos. Nossa equipe orienta você em cada etapa.',
  },
  {
    n: '2',
    titulo: 'Aprovação com o Produtor Eder Machado',
    desc: 'Ele avalia e aprova a música antes de ir pro ar, prazo combinado direto com você.',
  },
  {
    n: '3',
    titulo: 'Sua música no Spotify, Deezer e mais',
    desc: 'Distribuição oficial com direitos autorais e arrecadação em dia. Também colocamos de graça no Cifra Club e no Letras.mus.br.',
  },
];

// roster com 1 artista só fica esquisito exposto - escondido até ter mais gente
// (Toré, 21/07). Mantido aqui pronto pra reativar o grid quando crescer.
const artistas = [
  {
    nome: 'Eder Machado',
    desc: 'Música e clipes autorais',
    avatar: '/images/eder-avatar.png',
    href: 'https://eder.edtmusic.com.br',
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'MusicGroup',
  name: 'EDTMusic',
  url: 'https://edtmusic.com.br',
};
---
<Base
  title="EDTMusic | Selo de artistas"
  description="EDTMusic é o selo que reúne os artistas da Rede Loops Brasil. Conheça as músicas e os clipes de cada um."
  redeAtual="EDTMusic"
  structuredData={structuredData}
>
  <main class="flex min-h-screen flex-col items-center justify-center px-4 pb-16 pt-28 sm:px-6 sm:pt-24">
    <div class="mx-auto flex w-full max-w-2xl flex-col items-center text-center">
      <img
        src="/images/edtmusic-logo.png"
        alt="EDTMusic"
        class="h-9 w-auto sm:h-10"
        width="200"
        height="80"
      />

      <div class="mx-auto mt-6 flex h-10 items-end justify-center gap-1" aria-hidden="true">
        <span class="eq-bar w-1.5 rounded-full bg-gradient-to-t from-brand-purple to-brand-red"></span>
        <span class="eq-bar w-1.5 rounded-full bg-gradient-to-t from-brand-purple to-brand-red"></span>
        <span class="eq-bar w-1.5 rounded-full bg-gradient-to-t from-brand-purple to-brand-red"></span>
        <span class="eq-bar w-1.5 rounded-full bg-gradient-to-t from-brand-purple to-brand-red"></span>
        <span class="eq-bar w-1.5 rounded-full bg-gradient-to-t from-brand-purple to-brand-red"></span>
        <span class="eq-bar w-1.5 rounded-full bg-gradient-to-t from-brand-purple to-brand-red"></span>
        <span class="eq-bar w-1.5 rounded-full bg-gradient-to-t from-brand-purple to-brand-red"></span>
      </div>

      <h1 class="balance mt-[5px] font-hero text-5xl uppercase leading-[1.15] text-paper sm:text-6xl sm:leading-[1.15] md:text-7xl md:leading-[1.15]">
        Bora colocar sua música pra tocar no Spotify e no Deezer?
      </h1>
      <p class="balance mt-[5px] max-w-md font-display text-base leading-snug text-paper">
        O selo que grava, lança e coloca sua música pra tocar no Spotify,
        Deezer, Apple Music e YouTube: direitos autorais, contratos e arrecadação, tudo
        certo.
      </p>

      <a
        href={WHATSAPP_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-8 inline-flex items-center gap-2.5 rounded-full bg-gradient-to-r from-brand-purple to-brand-red px-8 py-4 font-accent text-lg uppercase tracking-wide text-white"
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5 fill-white"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5.1-1.3A10 10 0 1 0 12 2Zm0 18.2a8.1 8.1 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.4-.7-1.7-.8s-.4-.1-.6.1-.7.8-.9 1-.3.2-.6 0a6.7 6.7 0 0 1-2-1.2 7.4 7.4 0 0 1-1.4-1.7c-.1-.2 0-.4.1-.5s.2-.3.4-.4a1.6 1.6 0 0 0 .2-.4.5.5 0 0 0 0-.4c0-.1-.6-1.5-.8-2s-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 2.9 2.9 0 0 0-.9 2.2 5.1 5.1 0 0 0 1.1 2.7 11.6 11.6 0 0 0 4.4 3.9c.6.3 1.1.4 1.5.5a3.6 3.6 0 0 0 1.6.1 2.7 2.7 0 0 0 1.8-1.2 2.1 2.1 0 0 0 .1-1.2c-.1-.1-.2-.2-.5-.3Z"/></svg>
        Falar com a EDTMusic
      </a>
    </div>

    <div class="mx-auto mt-20 w-full max-w-3xl px-4 sm:px-0">
      <h2 class="text-center font-display text-2xl text-paper sm:text-3xl">Como funciona</h2>
      <div class="mt-8 grid gap-4 sm:grid-cols-3">
        {etapas.map((e) => (
          <div class="glow-card rounded-2xl bg-ink-raised p-5">
            <span class="font-display text-2xl text-brand-red">{e.n}</span>
            <p class="mt-2 font-semibold text-paper">{e.titulo}</p>
            <p class="mt-1.5 text-sm text-paper/60">{e.desc}</p>
          </div>
        ))}
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-center gap-6 opacity-70">
        <img src={PLATFORM_LOGOS.spotify} alt="Spotify" class="h-6 w-6" loading="lazy" />
        <img src={PLATFORM_LOGOS.apple} alt="Apple Music" class="h-6 w-6" loading="lazy" />
        <img src={PLATFORM_LOGOS.deezer} alt="Deezer" class="h-6 w-6" loading="lazy" />
        <img src={PLATFORM_LOGOS.youtube} alt="YouTube" class="h-6 w-6" loading="lazy" />
        <span class="text-lg font-bold tracking-[0.1em] text-paper/40" aria-label="e em mais plataformas">...</span>
      </div>

      <p class="mx-auto mt-8 max-w-xl text-center text-sm text-paper/60">
        Também colocamos sua música de graça no Cifra Club e no Letras.mus.br,
        e criamos o site oficial do seu projeto se você quiser.
      </p>

      <div class="mt-20">
        <p class="text-xs font-semibold uppercase tracking-[0.25em] text-brand-red">Discografia</p>
        <h2 class="mt-2 font-display text-2xl text-paper sm:text-3xl">Músicas no ar</h2>
        <div class="mt-4 h-px w-16 bg-gradient-to-r from-brand-purple to-brand-red"></div>

        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {releases.map((r) => (
            <div class="media-card group flex flex-col overflow-hidden bg-ink-raised">
              <span class="relative block aspect-square w-full overflow-hidden">
                <img
                  src={r.cover}
                  alt={`Capa de ${r.title}`}
                  loading="lazy"
                  class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                />
                <span class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink via-ink/10 to-transparent" />
                <span class="absolute inset-x-0 bottom-0 p-4">
                  <p class="font-display text-lg font-semibold leading-tight text-white">{r.title}</p>
                  <span class="mt-2 block h-px w-10 bg-white/50"></span>
                  <p class="mt-2 text-xs uppercase tracking-wide text-white/60">{r.artist}</p>
                </span>
              </span>
              <div class="flex items-center gap-4 px-4 py-3">
                <a href={r.spotify} target="_blank" rel="noopener noreferrer" aria-label={`Ouvir ${r.title} no Spotify`} class="text-white transition hover:text-brand-red">
                  <svg viewBox="0 0 24 24" class="h-5 w-5 fill-current"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm4.59 14.4a.62.62 0 0 1-.86.2c-2.36-1.44-5.33-1.77-8.83-.97a.62.62 0 1 1-.28-1.21c3.83-.88 7.12-.5 9.77 1.12.3.18.4.57.2.86Zm1.22-2.72a.78.78 0 0 1-1.07.26c-2.7-1.66-6.82-2.14-10.02-1.17a.78.78 0 1 1-.45-1.49c3.65-1.1 8.18-.57 11.28 1.33.37.23.49.72.26 1.07Zm.11-2.83c-3.24-1.92-8.59-2.1-11.68-1.16a.93.93 0 1 1-.54-1.78c3.55-1.08 9.44-.87 13.16 1.34a.93.93 0 1 1-.94 1.6Z"/></svg>
                </a>
                <a href={r.apple} target="_blank" rel="noopener noreferrer" aria-label={`Ouvir ${r.title} no Apple Music`} class="text-white transition hover:text-brand-red">
                  <svg viewBox="0 0 24 24" class="h-5 w-5 fill-current"><path d="M16.4 1.8c.1 1.1-.3 2.2-1 3-.7.8-1.8 1.5-2.9 1.4-.1-1.1.4-2.2 1-3 .8-.8 2-1.4 2.9-1.4Zm3.5 16.4c-.3.7-.6 1.3-1 1.9-.6.9-1.2 1.9-2.2 1.9-.9 0-1.2-.6-2.3-.6s-1.4.6-2.3.6c-.9 0-1.6-.9-2.2-1.8-1.5-2.2-2.6-6.2-1.1-8.9.7-1.3 2-2.2 3.4-2.2 1 0 2 .7 2.6.7.6 0 1.7-.8 2.9-.7.5 0 2 .2 2.9 1.5-.1.1-1.7 1-1.7 3 0 2.4 2.1 3.2 2.1 3.2 0 .1-.3 1.1-1.1 2.4Z"/></svg>
                </a>
                <a href={r.deezer} target="_blank" rel="noopener noreferrer" aria-label={`Ouvir ${r.title} no Deezer`} class="text-white transition hover:text-brand-purple">
                  <svg viewBox="0 0 24 24" class="h-5 w-5 fill-current"><rect x="1" y="14" width="4" height="4"/><rect x="7" y="10" width="4" height="8"/><rect x="13" y="6" width="4" height="12"/><rect x="19" y="2" width="4" height="16"/></svg>
                </a>
                <a href={r.youtube} target="_blank" rel="noopener noreferrer" aria-label={`Assistir ${r.title} no YouTube`} class="text-white transition hover:text-brand-purple">
                  <svg viewBox="0 0 24 24" class="h-5 w-5 fill-current"><path d="M23 12s0-3.6-.46-5.3a2.9 2.9 0 0 0-2-2C18.9 4.2 12 4.2 12 4.2s-6.9 0-8.54.5a2.9 2.9 0 0 0-2 2C1 8.4 1 12 1 12s0 3.6.46 5.3a2.9 2.9 0 0 0 2 2c1.64.5 8.54.5 8.54.5s6.9 0 8.54-.5a2.9 2.9 0 0 0 2-2C23 15.6 23 12 23 12ZM9.75 15.5v-7l6 3.5Z"/></svg>
                </a>
                <span class="text-sm font-bold tracking-[0.1em] text-white/40" aria-label="e em mais plataformas">...</span>
              </div>
            </div>
          ))}
        </div>
      </div>

      <a
        href="https://emmusicproducoes.com.br"
        class="glow-card mt-10 flex flex-col items-center gap-3 rounded-2xl bg-ink-raised p-6 text-center transition sm:flex-row sm:text-left"
      >
        <img
          src="/images/em-music-logo.png"
          alt="EM Music Produções"
          class="h-10 w-auto shrink-0"
          width="578"
          height="240"
        />
        <div>
          <p class="font-semibold text-paper">Ainda não gravou sua música?</p>
          <p class="mt-1 text-sm text-paper/60">
            A EM Music Produções grava, mixa e masteriza com o Eder Machado - deixa sua
            música pronta pra lançar pela EDTMusic.
          </p>
        </div>
      </a>
    </div>

    <div class="mx-auto mt-20 w-full max-w-5xl">
      <RedeFooter atual="EDTMusic" />
    </div>
  </main>
</Base>
